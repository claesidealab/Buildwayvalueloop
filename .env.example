# Copy to .env.local.

# Database. Leave DATABASE_URL unset to use the embedded database in .data/pglite.
# DATABASE_URL=postgres://user:password@localhost:5432/buildway_loop
# PGLITE_DIR=.data/pglite

# Public base URL, used for sign-in redirect URIs.
# AUTH_URL=https://loop.buildway.se

# Microsoft Entra ID (work accounts). Tenant "organizations" accepts any company.
# MICROSOFT_ENTRA_TENANT_ID=organizations
# MICROSOFT_ENTRA_CLIENT_ID=
# MICROSOFT_ENTRA_CLIENT_SECRET=

# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email domains of Buildway staff (comma-separated).
# BUILDWAY_EMAIL_DOMAINS=buildway.se

# Developer sign-in with example users. On by default outside production; never enable on a public site.
# AUTH_DEV_LOGIN=false
# Password for the developer sign-in. Required on a hosted (production) site when AUTH_DEV_LOGIN=true.
# AUTH_DEV_PASSWORD=

# AI-assisted flow discovery (optional). Without it the feature explains how to turn it on.
# ANTHROPIC_API_KEY=
